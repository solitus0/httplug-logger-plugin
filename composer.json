{
    "name": "solitus0/httplug-logger-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Solitus0\\HttplugLoggerBundle\\": "src/"
        }
    },
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Ernestas Pilsudskis",
            "email": "ernestas.pilsudskis@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "php-http/client-common": "^2.7",
        "php-http/guzzle7-adapter": "^1.0",
        "symfony/dependency-injection": ">=6.4",
        "symfony/http-kernel": ">=6.4",
        "symfony/config": ">=6.4",
        "monolog/monolog": ">=3.7"
    },
    "require-dev": {
        "symplify/easy-coding-standard": "^12.3",
        "phpunit/phpunit": ">10",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.7",
        "rector/rector": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
